APP_NAME=DOCTRY API
ENVIRONMENT=development

JWT_SECRET=remplacez-par-une-cle-aleatoire-longue
JWT_EXPIRE_MINUTES=720

MIN_REWARD_AMOUNT=1500
PLATFORM_COMMISSION_RATE=0.05
RATING_INTERVAL_DAYS=3
OTP_LENGTH=6
OTP_TTL_SECONDS=600
MATCHING_THRESHOLD=0.55

CORS_ORIGINS=*

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
MAIL_FROM=no-reply@doctry.app

TEXTSOFT_API_URL=
TEXTSOFT_API_KEY=
TEXTSOFT_SENDER=DOCTRY

# Supabase Auth : envoi des codes OTP par email (Authentication -> Providers -> Email).
# Laisser vide pour rester sur le flux OTP local (SMTP ou simulation).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# SQLite local (defaut) : laisser DATABASE_URL vide.
